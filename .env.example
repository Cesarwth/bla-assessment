# Copy to .env (git-ignored; `./scripts/start.sh` does it for you) and change the values for anything real.
# Never commit real secrets. The values below are DEMO-ONLY placeholders so the project runs out of the box.

# --- Database ---
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me-local-only

# --- API security ---
# At least 32 bytes or the API refuses to start. Generate one with: openssl rand -base64 48
# (./scripts/start.sh generates one for you; the API refuses this placeholder on purpose)
JWT_SECRET=change-me-change-me-change-me-change-me-0000
# Browser origins allowed to call the API directly. Not needed through the UI (nginx proxies /api), only for `npm run dev`.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Demo accounts and data (turn both flags off for a real deployment: it then starts empty) ---
SEED_DEMO_USER=true
SEED_DEMO_DATA=true
# user "demo"       (role USER)
DEMO_USER_PASSWORD=Demo12345
# user "demo-admin" (role ADMIN: edits anything and is the only one who can delete)
DEMO_ADMIN_PASSWORD=Admin12345
