# Copy to .env (git-ignored) and change the values. Never commit real secrets.
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me-local-only
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-0000
SEED_DEMO_USER=true
# Demo-only account (user: demo). Disable seeding outside demos.
DEMO_USER_PASSWORD=Demo12345
CORS_ALLOWED_ORIGINS=http://localhost:5173
