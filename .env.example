# Copy to .env (git-ignored; `./scripts/start.sh` does it for you) and change the values for anything real.
# Never commit real secrets. The values below are DEMO-ONLY placeholders so the project runs out of the box.

# --- Database ---
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me-local-only

# --- API security ---
# At least 32 bytes or the API refuses to start. Generate one with: openssl rand -base64 48
# (./scripts/start.sh generates one for you; the API refuses this placeholder on purpose)
JWT_SECRET=change-me-change-me-change-me-change-me-0000
# Browser origins allowed to call the API directly. Not needed through the UI (nginx proxies /api), only for `npm run dev`.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Ports on this machine (127.0.0.1) ---
# ./scripts/start.sh keeps these if they are free and picks the next free port when something else already uses them.
WEB_PORT=8081
API_PORT=8080
MAIL_UI_PORT=8025

# --- Password reset e-mails ---
# In Docker the demo sends them to the bundled Mailpit mailbox: open the mailbox (http://localhost:MAIL_UI_PORT) to read them.
# For real e-mail point MAIL_HOST/MAIL_PORT at your SMTP server (and drop the mailpit service from docker-compose.yml).
MAIL_FROM=no-reply@pokedex.local
# The address users open the app at; the reset link in the e-mail is built from it.
APP_PUBLIC_URL=http://localhost:8081

# --- Demo accounts and data (turn both flags off for a real deployment: it then starts empty) ---
SEED_DEMO_USER=true
SEED_DEMO_DATA=true
# user "demo"       (role USER)
DEMO_USER_PASSWORD=Demo12345
# user "demo-admin" (role ADMIN: a trainer with their own collection; the role is reserved for future admin features)
DEMO_ADMIN_PASSWORD=Admin12345
